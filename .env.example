# Copy this file to .env and fill in your values: pytest reads .env automatically.
# .env is gitignored, so the password stays on your machine.
# Variables already set in the shell ($env:..., setx, export) take precedence over .env.

ODOO_URL=https://integration.cc1.vn
ODOO_USER=
ODOO_PASSWORD=
ODOO_DB=
ODOO_VERSION=17

# false = show the browser; SLOW_MO slows every action down (milliseconds)
HEADLESS=false
SLOW_MO=0

# Optional: default invoice PDF file(s) or folder for test_create_po_from_vendor_invoice
# (several paths separated by ';')
# VENDOR_INVOICE_PATH=C:\Users\me\Downloads\HoaDon
